# ===== Supabase (backend) — required for live production mode =====
# 1. Create a project at https://supabase.com (free tier)
# 2. Run supabase/schema.sql in the SQL editor
# 3. Paste the values below from Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=                     # same URL as above — server-side only
SUPABASE_SERVICE_ROLE_KEY=        # server-side only (webhook writes) — NEVER expose to the client

# ===== Google OAuth (optional) =====
# Supabase Dashboard → Authentication → Providers → Google → enable + credentials
# Set Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback

# ===== Razorpay (real payments) =====
# 1. Create account at https://razorpay.com (test mode first!)
# 2. Paste Key ID below; Key ID + Secret go to Vercel env vars
VITE_RAZORPAY_KEY_ID=             # public — safe for the browser
RAZORPAY_KEY_ID=                  # server-side only
RAZORPAY_KEY_SECRET=              # server-side only
RAZORPAY_WEBHOOK_SECRET=          # server-side only (set when adding the /api/webhook webhook)
